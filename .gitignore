# CDK build output
cdk.out/
cdk.out.*/
cdk.context.json

# Generated container build context (produced by scripts/prepare_context.sh)
docker/inference/src/
docker/inference/scripts/
docker/compile_cpu/src/
docker/compile_cpu/scripts/
docker/compile_verify/src/
docker/compile_verify/scripts/

# Environment
.env
.env.local
.env.outputs

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/

# Node / Frontend
node_modules/
dist/

# Coverage
.coverage

# Editor / IDE / OS
.ipynb_checkpoints/
.idea/
.vscode/
.mypy_cache/
.DS_Store
# Office lock files and draw.io backups
~$*
*.bkp

# Playwright / browser-automation output (logs can contain presigned URLs
# with temporary STS credentials)
.playwright-mcp/
test-results/
playwright-report/
blob-report/

# Test / coverage reports
htmlcov/
coverage.xml
junit*.xml

# Root-level developer scripts (local-only). Anchored with a leading slash so
# infra/stacks/constructs/cicd/scripts/ (pipeline buildspec scripts) stays tracked.
/scripts/

# Root Playwright config (only drove the local post-deploy UI test in /scripts/)
/playwright.config.ts

# Local AI-assistant config and state (settings, memory, rules, agents)
.claude/
.loop_state

# Internal-only documents: security reviews, vulnerability exports/triage,
# unpublished blog drafts, scratch images
securityreview.md
/img.png
/ARCHITECTURE.md
/DEPLOYMENT.md

# docs/ is local-only except the images README.md embeds. Uses docs/* (not
# docs/) so the ! re-includes below can take effect.
docs/*
!docs/z-image-inferentia-architecture.png
!docs/samples/
docs/samples/poster_*

# Generated docker contexts
docker/*/src/
docker/*/scripts/
docker/*/neffs/

# Secrets / credentials
*.pem
*.key
credentials*
.env.*
!.env.example
.secrets.baseline
!.ash/.secrets.baseline

# ASH scan output — regenerated by `make security` / `make security-web` on every
# pipeline run, so committing it only ships stale findings. Config files
# (.ash/ash.yaml, .ash/.checkov.yaml, .ash/.secrets.baseline) stay tracked.
.ash/out/
.ash/out-web/
